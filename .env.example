# SQLite storage for the standalone cabinet; never shares course DB data.
CABINET_DB_PATH=./var/cabinet.sqlite3
CABINET_MANIFEST=./manifest.course.json

# Dedicated PostgreSQL 17 read-only role for the learning database.
CABINET_LEARNING_DSN=postgresql://cabinet_reader:change-me@localhost:5432/demo?sslmode=require

# Random long token for teacher endpoints. Keep it out of source control.
CABINET_ADMIN_TOKEN=replace-with-a-long-random-secret
CABINET_ADMIN_NAME=Преподаватель
